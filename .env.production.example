# Production environment template for the CollabOS backend on the VPS.
#
# This file documents every variable NAME the app validates at boot
# (src/config/env.validation.ts) and, where safe, a sensible production
# default. It contains NO real secrets — every secret-shaped value below is
# a placeholder. Copy this to /opt/collabos/.env.production on the VPS (or
# another 0600-permission path outside the repo), fill in real values there,
# and never commit that file. `.env.production` is gitignored in this repo
# for exactly that reason.
#
# Names/requiredness here are generated from the actual zod schema, not
# invented — every REQUIRED (no default) variable in that schema appears
# below with no placeholder guessed for values only a real provider can
# supply (DB, Redis, SMTP, Stripe, S3/R2, Anthropic, Sentry).

NODE_ENV=production
PORT=3000

# --- Database (REQUIRED) ------------------------------------------------
# Real reachable Postgres. Never localhost in production. If using the
# collabos-postgres service from docker-compose.production.yml, host is
# that service name, not localhost, e.g.:
#   postgresql://collabos:<password>@collabos-postgres:5432/collabos?schema=public
DATABASE_URL=

# Only needed if using the collabos-postgres service from
# docker-compose.production.yml (it bootstraps the container with these on
# first run) — POSTGRES_USER/PASSWORD/DB must match what you put in
# DATABASE_URL above. Not read by the API itself; read only by the Postgres
# container's own entrypoint. Generate the password on the VPS:
# openssl rand -hex 24
POSTGRES_USER=collabos
POSTGRES_PASSWORD=
POSTGRES_DB=collabos

# --- Redis ---------------------------------------------------------------
# If using the collabos-redis service from docker-compose.production.yml,
# these two are overridden there to collabos-redis:6379 regardless of what
# you put here — set them anyway for any out-of-Compose use (e.g. running
# the API directly on the host for debugging).
REDIS_HOST=collabos-redis
REDIS_PORT=6379
REDIS_PASSWORD=

# --- CORS / frontend origin (REQUIRED to be correct, has a default of *) -
# Never leave this as * once cookies/credentials are in play. Set to the
# exact production frontend origin once known (Phase 24 of the release plan).
CORS_ORIGIN=
CLIENT_URL=

SWAGGER_ENABLED=false

# --- Auth (REQUIRED, min 32 chars each) -----------------------------------
# Generate on the VPS, never in chat: openssl rand -hex 32
JWT_ACCESS_SECRET=
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_SECRET=
JWT_REFRESH_EXPIRES_IN=7d

BCRYPT_SALT_ROUNDS=12

# --- SMTP (host REQUIRED; real provider credentials) ----------------------
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=CollabOS <no-reply@collabos.software>

# --- Local upload dirs (only relevant if STORAGE_PROVIDER=local below;
#     these are for avatars/brand assets/message attachments etc., which are
#     always local-disk regardless of the opportunity-asset storage choice) -
AVATAR_UPLOAD_DIR=./uploads/avatars
AVATAR_MAX_SIZE_MB=5
BRAND_ASSET_UPLOAD_DIR=./uploads/brands
BRAND_LOGO_MAX_SIZE_MB=5
BRAND_COVER_MAX_SIZE_MB=8
MESSAGE_ATTACHMENT_UPLOAD_DIR=./uploads/messages
MESSAGE_ATTACHMENT_MAX_SIZE_MB=10
CONTRACT_PDF_UPLOAD_DIR=./uploads/contracts
DROP_MEDIA_UPLOAD_DIR=./uploads/drops
DROP_MEDIA_MAX_SIZE_MB=20
PRODUCT_MEDIA_UPLOAD_DIR=./uploads/products
PRODUCT_MEDIA_MAX_SIZE_MB=10
INVOICE_PDF_UPLOAD_DIR=./uploads/invoices
# If STORAGE_PROVIDER=local (below) and running via Docker, all of the above
# upload dirs, plus the opportunity-asset storage dir, must live under a
# mounted volume (see the commented collabos_uploads volume in
# docker-compose.production.yml) — never only in the container filesystem.

# --- Webhooks (REQUIRED, min 16 chars) ------------------------------------
# Generate on the VPS: openssl rand -hex 24
ORDERS_WEBHOOK_SECRET=

# --- Stripe (REQUIRED; TEST mode keys only for this launch) --------------
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_CONNECT_REFRESH_URL=https://api.collabos.software/payouts/refresh
STRIPE_CONNECT_RETURN_URL=https://api.collabos.software/payouts/complete
PLATFORM_FEE_PERCENT=10
STRIPE_PAYOUTS_WEBHOOK_SECRET=
PAYOUT_MINIMUM_AMOUNT=20

# --- Optional integrations (safe to leave blank; app degrades gracefully) -
PUSH_PROVIDER_WEBHOOK_URL=
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-4-5-20251001
AI_CACHE_TTL_SECONDS=900

THROTTLE_TTL_MS=60000
THROTTLE_LIMIT=100

SENTRY_DSN=
SENTRY_TRACES_SAMPLE_RATE=0.1

TYPESENSE_HOST=
TYPESENSE_PORT=443
TYPESENSE_PROTOCOL=https
TYPESENSE_API_KEY=
SEARCH_REINDEX_INTERVAL_MS=300000

# --- Object storage (opportunity/document assets) -------------------------
# "local" needs a mounted Docker volume (see compose file) and is the
# simpler first-deployment choice. "s3" is preferred for real scale and
# works with any S3-compatible provider, including Cloudflare R2 via
# STORAGE_S3_ENDPOINT. Choose deliberately — see Phase 6 of the release plan.
STORAGE_PROVIDER=local
STORAGE_LOCAL_DIR=./uploads/storage
STORAGE_LOCAL_PUBLIC_BASE_URL=https://api.collabos.software/storage
# Generate on the VPS: openssl rand -hex 32
STORAGE_SIGNING_SECRET=
STORAGE_S3_BUCKET=
STORAGE_S3_REGION=auto
STORAGE_S3_ENDPOINT=
STORAGE_S3_ACCESS_KEY_ID=
STORAGE_S3_SECRET_ACCESS_KEY=
STORAGE_S3_PUBLIC_BASE_URL=

OTEL_SERVICE_NAME=collabos-backend
OTEL_EXPORTER_OTLP_ENDPOINT=

# --- Opportunity Creation Studio ------------------------------------------
OPPORTUNITY_ASSET_MAX_SIZE_MB=15
OPPORTUNITY_ASSET_URL_TTL_SECONDS=900
# Defaults to ${CLIENT_URL}/share if left unset:
# OPPORTUNITY_SHARE_BASE_URL=https://app.collabos.software/share
OPPORTUNITY_AI_MAX_TOKENS=2048

# --- Compose image tag / host port (used by docker-compose.production.yml,
#     not read by the app itself) ------------------------------------------
COLLABOS_IMAGE_TAG=latest
# 3000 and 3001 are already taken by other projects on the target VPS —
# see docs/vps-deployment-audit.md. Adjust per-host if 3002 is ever taken too.
COLLABOS_API_HOST_PORT=3002
