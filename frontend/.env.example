# Backend base URL (server-only; never exposed to the browser).
# The browser talks only to this app's /api/* route handlers (BFF).
API_URL=http://localhost:3000

# Stripe *publishable* key (pk_...). Public by design — used only by Stripe.js
# to confirm card payments. Never put the Stripe secret key here.
# Leave empty to disable in-app card payments (orders stay pending).
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
