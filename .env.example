NODE_ENV=development
PORT=3000

DATABASE_URL=postgresql://collabos:collabos@localhost:5432/collabos?schema=public

REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

CORS_ORIGIN=*
CLIENT_URL=http://localhost:5173

SWAGGER_ENABLED=true

JWT_ACCESS_SECRET=change-me-access-secret-min-32-chars-long
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_SECRET=change-me-refresh-secret-min-32-chars-long
JWT_REFRESH_EXPIRES_IN=7d

BCRYPT_SALT_ROUNDS=12

SMTP_HOST=localhost
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=CollabOS <no-reply@collabos.io>

AVATAR_UPLOAD_DIR=./uploads/avatars
AVATAR_MAX_SIZE_MB=5

BRAND_ASSET_UPLOAD_DIR=./uploads/brands
BRAND_LOGO_MAX_SIZE_MB=5
BRAND_COVER_MAX_SIZE_MB=8

MESSAGE_ATTACHMENT_UPLOAD_DIR=./uploads/messages
MESSAGE_ATTACHMENT_MAX_SIZE_MB=10

CONTRACT_PDF_UPLOAD_DIR=./uploads/contracts

DROP_MEDIA_UPLOAD_DIR=./uploads/drops
DROP_MEDIA_MAX_SIZE_MB=20

PRODUCT_MEDIA_UPLOAD_DIR=./uploads/products
PRODUCT_MEDIA_MAX_SIZE_MB=10

ORDERS_WEBHOOK_SECRET=change-me-webhook-secret-min-16-chars

STRIPE_SECRET_KEY=sk_test_change_me
STRIPE_WEBHOOK_SECRET=whsec_change_me
STRIPE_CONNECT_REFRESH_URL=http://localhost:5173/settings/payouts/refresh
STRIPE_CONNECT_RETURN_URL=http://localhost:5173/settings/payouts/complete
PLATFORM_FEE_PERCENT=10

INVOICE_PDF_UPLOAD_DIR=./uploads/invoices

STRIPE_PAYOUTS_WEBHOOK_SECRET=whsec_change_me_payouts
PAYOUT_MINIMUM_AMOUNT=20

# Optional: leave unset to log push dispatches instead of calling a real provider
PUSH_PROVIDER_WEBHOOK_URL=

# Optional: leave unset to use deterministic template fallback instead of calling Claude
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-4-5-20251001
AI_CACHE_TTL_SECONDS=900

# Global rate limit: THROTTLE_LIMIT requests per THROTTLE_TTL_MS per client
THROTTLE_TTL_MS=60000
THROTTLE_LIMIT=100

# Optional: leave unset to disable Sentry error reporting entirely
SENTRY_DSN=
SENTRY_TRACES_SAMPLE_RATE=0.1

# Optional: leave TYPESENSE_HOST unset to disable search (endpoints return a clear "not configured" response)
TYPESENSE_HOST=
TYPESENSE_PORT=443
TYPESENSE_PROTOCOL=https
TYPESENSE_API_KEY=
SEARCH_REINDEX_INTERVAL_MS=300000

# StorageProvider abstraction: local (default) or s3 (S3-compatible — also covers Cloudflare R2 via STORAGE_S3_ENDPOINT)
STORAGE_PROVIDER=local
STORAGE_LOCAL_DIR=./uploads/storage
STORAGE_LOCAL_PUBLIC_BASE_URL=http://localhost:3000/storage
STORAGE_SIGNING_SECRET=change-me-storage-signing-secret
STORAGE_S3_BUCKET=
STORAGE_S3_REGION=auto
STORAGE_S3_ENDPOINT=
STORAGE_S3_ACCESS_KEY_ID=
STORAGE_S3_SECRET_ACCESS_KEY=
STORAGE_S3_PUBLIC_BASE_URL=

# OpenTelemetry distributed tracing: exports to console when OTEL_EXPORTER_OTLP_ENDPOINT is unset
OTEL_SERVICE_NAME=collabos-backend
OTEL_EXPORTER_OTLP_ENDPOINT=

# Opportunity Creation Studio
OPPORTUNITY_ASSET_MAX_SIZE_MB=15
# Lifetime of signed asset URLs returned by the API and share endpoint
OPPORTUNITY_ASSET_URL_TTL_SECONDS=900
# Optional: base URL of the frontend share page (defaults to ${CLIENT_URL}/share)
# OPPORTUNITY_SHARE_BASE_URL=https://app.collabos.io/share
OPPORTUNITY_AI_MAX_TOKENS=2048
